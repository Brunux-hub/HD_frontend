// ============================================================================
// HEALTHY PETS - PRISMA SCHEMA DEFINITION
// Matches 1:1 with PostgreSQL Schema in /schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
enum UserType {
  ADMIN
  WORKER

  @@map("user_type_enum")
}

enum StaffRole {
  ADMIN
  VETERINARIAN
  RECEPTIONIST
  CLIENT
  WORKER

  @@map("staff_role_enum")
}

enum PetGender {
  MALE
  FEMALE

  @@map("pet_gender_enum")
}

enum AppointmentStatus {
  OPENED
  CLOSED
  CANCELED
  RESCHEDULED

  @@map("appointment_status_enum")
}

// ----------------------------------------------------------------------------
// Models
// ----------------------------------------------------------------------------
model User {
  id_user      Int           @id @default(autoincrement())
  username     String        @unique @db.VarChar(50)
  password     String        @db.VarChar(255)
  type         UserType      @default(WORKER)
  role         StaffRole     @default(CLIENT)
  created_at   DateTime      @default(now()) @db.Timestamptz()
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz()

  owner        Owner?
  receptionist Receptionist?
  veterinarian Veterinarian?

  @@map("users")
}

model Owner {
  id_owner     Int       @id @default(autoincrement())
  id_user      Int?      @unique
  dni          String    @unique @db.VarChar(20)
  names        String    @db.VarChar(100)
  last_names   String    @db.VarChar(100)
  email        String    @db.VarChar(150)
  phone_number String    @db.VarChar(30)
  address      String    @db.Text
  created_at   DateTime  @default(now()) @db.Timestamptz()
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz()

  user         User?     @relation(fields: [id_user], references: [id_user], onDelete: SetNull)
  pets         Pet[]

  @@map("owners")
}

model Receptionist {
  id_receptionist Int           @id @default(autoincrement())
  id_user         Int           @unique
  names           String        @db.VarChar(100)
  last_names      String        @db.VarChar(100)
  email           String        @db.VarChar(150)
  phone_number    String        @db.VarChar(30)
  created_at      DateTime      @default(now()) @db.Timestamptz()
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz()

  user            User          @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  appointments    Appointment[]

  @@map("receptionists")
}

model Veterinarian {
  id_veterinarian Int           @id @default(autoincrement())
  id_user         Int           @unique
  names           String        @db.VarChar(100)
  last_names      String        @db.VarChar(100)
  number_license  String        @unique @db.VarChar(50)
  specialty       String        @default("General Medicine") @db.VarChar(100)
  email           String        @db.VarChar(150)
  phone_number    String        @db.VarChar(30)
  created_at      DateTime      @default(now()) @db.Timestamptz()
  updated_at      DateTime      @default(now()) @updatedAt @db.Timestamptz()

  user            User          @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
  appointments    Appointment[]

  @@map("veterinarians")
}

model Pet {
  id_pet       Int           @id @default(autoincrement())
  id_owner     Int
  name         String        @db.VarChar(100)
  species      String        @db.VarChar(50)
  race         String        @db.VarChar(100)
  birthdate    DateTime      @db.Date
  pet_gender   PetGender
  weight       String        @db.VarChar(20)
  created_at   DateTime      @default(now()) @db.Timestamptz()
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz()

  owner        Owner         @relation(fields: [id_owner], references: [id_owner], onDelete: Restrict)
  appointments Appointment[]

  @@map("pets")
}

model Service {
  id_service        Int              @id @default(autoincrement())
  name              String           @unique @db.VarChar(100)
  description       String           @default("") @db.Text
  price             Decimal          @default(0.00) @db.Decimal(10, 2)
  created_at        DateTime         @default(now()) @db.Timestamptz()
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz()

  medical_histories MedicalHistory[]

  @@map("services")
}

model Appointment {
  id_appointment  Int                @id @default(autoincrement())
  id_receptionist Int
  id_pet          Int
  id_veterinarian Int
  date            DateTime           @db.Timestamptz()
  time_minutes    Int                @default(30)
  reason          String             @db.Text
  notes           String             @default("") @db.Text
  status          AppointmentStatus  @default(OPENED)
  created_at      DateTime           @default(now()) @db.Timestamptz()
  updated_at      DateTime           @default(now()) @updatedAt @db.Timestamptz()

  receptionist    Receptionist       @relation(fields: [id_receptionist], references: [id_receptionist], onDelete: Restrict)
  pet             Pet                @relation(fields: [id_pet], references: [id_pet], onDelete: Cascade)
  veterinarian    Veterinarian       @relation(fields: [id_veterinarian], references: [id_veterinarian], onDelete: Restrict)
  medical_history MedicalHistory?

  @@map("appointments")
}

model MedicalHistory {
  id_medical_history Int           @id @default(autoincrement())
  id_appointment     Int           @unique
  id_service         Int
  description        String        @db.Text
  date               DateTime      @db.Timestamptz()
  created_at         DateTime      @default(now()) @db.Timestamptz()
  updated_at         DateTime      @default(now()) @updatedAt @db.Timestamptz()

  appointment        Appointment   @relation(fields: [id_appointment], references: [id_appointment], onDelete: Cascade)
  service            Service       @relation(fields: [id_service], references: [id_service], onDelete: Restrict)
  vaccinations       Vaccination[]

  @@map("medical_histories")
}

model Vaccine {
  id_vaccine    Int           @id @default(autoincrement())
  name          String        @unique @db.VarChar(100)
  description   String        @default("") @db.Text
  manufacturer  String        @db.VarChar(100)
  required_dose Int           @default(1)
  created_at    DateTime      @default(now()) @db.Timestamptz()
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamptz()

  vaccinations  Vaccination[]

  @@map("vaccines")
}

model Vaccination {
  id_vaccination        Int            @id @default(autoincrement())
  id_medical_history    Int
  id_vaccine            Int
  application_date      DateTime       @db.Timestamptz()
  next_application_date DateTime?      @db.Timestamptz()
  observation           String         @default("") @db.Text
  created_at            DateTime       @default(now()) @db.Timestamptz()
  updated_at            DateTime       @default(now()) @updatedAt @db.Timestamptz()

  medical_history       MedicalHistory @relation(fields: [id_medical_history], references: [id_medical_history], onDelete: Cascade)
  vaccine               Vaccine        @relation(fields: [id_vaccine], references: [id_vaccine], onDelete: Restrict)

  @@map("vaccinations")
}
